# =============================================================================
# SMART STORE — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# In production on Vercel, set these environment variables in Project Settings > Environment Variables.

# -----------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Neon PostgreSQL with connection pooling)
# -----------------------------------------------------------------------------
# Example Neon pooled connection string:
# postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/smartstore?sslmode=require"

# -----------------------------------------------------------------------------
# 2. SESSION SECRET (Used for signing/hashing admin sessions)
# -----------------------------------------------------------------------------
# Generate a secure 64-character random key (e.g. using `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET="change_this_to_a_random_64_character_hex_string_in_production"

# -----------------------------------------------------------------------------
# 3. OPTIONAL CLI SEEDING OVERRIDES (Optional for `npm run seed:admin`)
# -----------------------------------------------------------------------------
# If left unset, `npm run seed:admin` will prompt you interactively in your terminal.
# ADMIN_EMAIL="admin@smartstore.app"
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="your_strong_password_here"

